{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory product item in store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "barcode": { "type": "string", "maxLength": 128 },
        "nameAr": { "type": "string", "maxLength": 200 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "categoryAr": { "type": "string", "maxLength": 100 },
        "categoryEn": { "type": "string", "maxLength": 100 },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "minQuantity": { "type": "number" }
      },
      "required": ["id", "barcode", "nameAr", "sellingPrice", "quantity"]
    },
    "CustomerDebt": {
      "title": "CustomerDebt",
      "description": "Customer debt balance and transaction history record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "totalDebt": { "type": "number" },
        "lastTransactionDate": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "totalDebt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Completed point-of-sale receipt transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 100 },
        "totalAmount": { "type": "number" },
        "profit": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "debt"] },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "date", "totalAmount", "profit", "paymentMethod"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Merchant app subscriber account managed by app owner",
      "type": "object",
      "properties": {
        "syncCode": { "type": "string", "maxLength": 64 },
        "shopName": { "type": "string", "maxLength": 200 },
        "ownerName": { "type": "string", "maxLength": 200 },
        "ownerPhone": { "type": "string", "maxLength": 50 },
        "wilaya": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "expired", "suspended"] },
        "subscriptionStartDate": { "type": "string", "maxLength": 100 },
        "subscriptionEndDate": { "type": "string", "maxLength": 100 },
        "monthlyFee": { "type": "number" },
        "lastPaymentDate": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["syncCode", "shopName", "status"]
    },
    "Store": {
      "title": "Store",
      "description": "Cloud synchronized store profile",
      "type": "object",
      "properties": {
        "syncCode": { "type": "string", "maxLength": 64 },
        "shopName": { "type": "string", "maxLength": 200 },
        "lastUpdated": { "type": "number" },
        "devicesCount": { "type": "number" }
      },
      "required": ["syncCode", "shopName"]
    }
  },
  "firestore": {
    "/stores/{syncCode}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Store configuration and sync root document"
    },
    "/stores/{syncCode}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products inventory for store"
    },
    "/stores/{syncCode}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/CustomerDebt" },
      "description": "Debts records for store"
    },
    "/stores/{syncCode}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Sales transactions for store"
    },
    "/subscribers/{syncCode}": {
      "schema": { "$ref": "#/entities/Subscriber" },
      "description": "Subscriber subscriptions registry"
    }
  }
}
